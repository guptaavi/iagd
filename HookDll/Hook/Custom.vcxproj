  <!--
    Stamps the hook DLL with a build-timestamp version, using the same scheme as IAGrim.csproj:
      build    = whole days since 2000-01-01
      revision = 2-second ticks since midnight (0..43199)
    This used to be done by setversion.cmd, which read the version back out of a previously built iagrim.exe.
    Nothing compares the DLL version against the exe version (dllver.txt is derived from the DLL itself), so
    the DLL can just stamp itself and no longer depends on the C# build having run first.

    IAGD_VER only ever reaches a string resource (VALUE "FileVersion" / "ProductVersion" in GDIAHook.rc), never
    the numeric FILEVERSION, so unlike the managed assembly version it can carry the zero-padded revision.
    Padded is what the git tags and AssemblyInformationalVersion use, keeping all three spellings identical.
  -->
  <PropertyGroup>
    <IagdVersionBuild>$([System.Math]::Floor($([System.DateTime]::Now.Subtract($([System.DateTime]::new(2000,1,1,0,0,0))).TotalDays)))</IagdVersionBuild>
    <IagdVersionRevision>$([System.Convert]::ToUInt16($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds),2))))</IagdVersionRevision>
    <IagdVersionRevisionPadded>$([System.String]::Format('{0:00000}', $([System.Convert]::ToInt32($(IagdVersionRevision)))))</IagdVersionRevisionPadded>
    <IagdVersion>1.5.$(IagdVersionBuild).$(IagdVersionRevisionPadded)</IagdVersion>
  </PropertyGroup>
  <Target Name="GenerateIagdVersionHeader" BeforeTargets="ResourceCompile;ClCompile">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\version_generated.h" Overwrite="true" WriteOnlyWhenDifferent="false" Lines="// Generated by the GenerateIagdVersionHeader target in Custom.vcxproj. Do not edit, do not commit.;#pragma once;#define IAGD_VER &quot;$(IagdVersion)&quot;" />
    <Message Importance="high" Text="Hook DLL version: $(IagdVersion)" />
  </Target>
