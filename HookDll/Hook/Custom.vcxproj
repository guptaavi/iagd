    <!--
      The vendored SQLite amalgamation. It is C, not C++, so it must not use the
      project's C++ precompiled header. Its warnings are the upstream project's to
      care about, not ours, so they are turned down rather than left to bury our own.
      Build options come from SqliteCompileDefinitions in ..\Directory.Build.props.
    -->
    <ClCompile Include="$(SqliteDir)\sqlite3.c">
      <CompileAs>CompileAsC</CompileAs>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>$(SqliteCompileDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <!--
      RmlUi's renderer and platform backends. RmlUi ships these as sample code that each
      application copies rather than as part of the library, so they are compiled here
      rather than linked from rmlui.lib. They are used unmodified; OverlayUi.cpp adapts
