# Grim Dawn debug overrides - sourced by launch-grimdawn-box64.sh if this file exists.
#
# DELETE THIS FILE to go back to a normal launch. Nothing in the launcher needs undoing.
#
# Run ONE experiment at a time, or you will not know which one moved the needle.
# Alongside each run:   gd-stutter-probe.py 60 ~/stutter-<experiment>.tsv

# --- EXPERIMENT 1 (active): watch the shader compiler -------------------------
# The HUD's "compiler" element lights up while pipelines are being built. If it is dark at
# the moment the screen freezes, shader compilation is not the cause and experiment 3 is
# pointless. Observational only - it changes no behaviour.
export DXVK_HUD=fps,frametimes,compiler,pipelines,version

# --- EXPERIMENT 2: does WAIT=1 actually help? ---------------------------------
# The launcher sets BOX64_DYNAREC_WAIT=1 with a comment claiming it avoids the input-thread
# stall when Sunshine injects controller state - the very symptom still happening. Test the
# claim. WAIT=0 runs the interpreter instead of blocking on a block being built.
#   worse  -> the comment is right, the stall is dynarec contention
#   gone   -> the comment is stale and WAIT=1 is now causing what it was meant to prevent
# export BOX64_DYNAREC_WAIT=0

# --- EXPERIMENT 3: stop the compiler threads crowding the fast cores ----------
# DXVK starts 20 compiler threads, but the launcher pins the game to the 10 Cortex-X925
# cores, so a compile burst puts 20 hungry threads on the 10 cores the render thread needs.
# Only worth running if the HUD showed the compiler active during a freeze.
# export DXVK_NUM_COMPILER_THREADS=4

# --- EXPERIMENT 4: is the pad involved at all? --------------------------------
# The mouse keeps Wine's message pump alive; the pad may not. If the freezes disappear with
# the pad unplugged and you move with the mouse only, it is an input-path problem, not a
# graphics or translation one.
# (no variable - just play without the controller connected)
